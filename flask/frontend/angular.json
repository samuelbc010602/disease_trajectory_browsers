{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dtb": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/dtb",
      "sourceRoot": "projects/dtb/src",
      "prefix": "dtb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/dtb",
            "index": "projects/dtb/src/index.html",
            "main": "projects/dtb/src/main.ts",
            "polyfills": "projects/dtb/src/polyfills.ts",
            "tsConfig": "projects/dtb/tsconfig.app.json",
            "assets": [
              "projects/dtb/src/favicon.ico",
              "projects/dtb/src/assets"
            ],
            "styles": [
              "projects/dtb/src/custom-theme.scss",
              "projects/dtb/src/styles.css",
              "node_modules/cookieconsent/build/cookieconsent.min.css"
            ],
            "allowedCommonJsDependencies": [
              "cytoscape",
              "cytoscape-dagre",
              "json2csv",
              "file-saver"
            ],
            "scripts": [
              "node_modules/cookieconsent/build/cookieconsent.min.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/cytoscape/dist/cytoscape.min.js",
              "node_modules/dagre/dist/dagre.min.js",
              "node_modules/cytoscape-dagre/cytoscape-dagre.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2500kb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "12kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/dtb/src/environments/environment.ts",
                  "with": "projects/dtb/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "dtb:build:production"
            },
            "development": {
              "browserTarget": "dtb:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "dtb:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/dtb/src/test.ts",
            "polyfills": "projects/dtb/src/polyfills.ts",
            "tsConfig": "projects/dtb/tsconfig.spec.json",
            "karmaConfig": "projects/dtb/karma.conf.js",
            "assets": [
              "projects/dtb/src/favicon.ico",
              "projects/dtb/src/assets"
            ],
            "styles": [
              "projects/dtb/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
